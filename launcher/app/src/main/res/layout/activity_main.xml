<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Subtle time-of-day atmospheric backdrop -->
    <View
        android:id="@+id/skyBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="40sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="5dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="6dp"
                        android:background="#33FFFFFF" />

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="6dp"
                        android:format12Hour="EEEE  d MMMM"
                        android:format24Hour="EEEE  d MMMM"
                        android:textColor="#A6FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:letterSpacing="0.12"
                        android:textAllCaps="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- 1. Big Boxes Row: Weather, Sunrise, Navakarsi, Sunset -->
        <LinearLayout
            android:id="@+id/solarBoxesRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- Card 1: Weather -->
            <LinearLayout
                android:id="@+id/boxWeather"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_solar_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤  WEATHER"
                    android:textColor="#A6FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvBoxWeatherTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="--°"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/tvBoxWeatherCond"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Updating..."
                    android:textColor="#8CFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Card 2: Sunrise -->
            <LinearLayout
                android:id="@+id/boxSunrise"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_solar_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️  SUNRISE"
                    android:textColor="#A6FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvBoxSunriseTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="--:--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Dawn"
                    android:textColor="#8CFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>

            <!-- Card 3: Navakarsi (Highlighted) -->
            <LinearLayout
                android:id="@+id/boxNavakarsi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_solar_card_navakarsi"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨  NAVAKARSI"
                    android:textColor="#FFE5A3"
                    android:textSize="10sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvBoxNavakarsiTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="--:--"
                    android:textColor="#FFF3D1"
                    android:textSize="22sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Sunrise + 48 min"
                    android:textColor="#CCFFE5A3"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>

            <!-- Card 4: Sunset -->
            <LinearLayout
                android:id="@+id/boxSunset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_solar_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌇  SUNSET"
                    android:textColor="#A6FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvBoxSunsetTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="--:--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Dusk"
                    android:textColor="#8CFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Next 7 Days Jain Tithi Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="JAIN TITHI — NEXT 7 DAYS"
            android:textColor="#73FFFFFF"
            android:textSize="9.5sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="0.16" />

        <LinearLayout
            android:id="@+id/tithiRibbon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_strip_frosted"
            android:orientation="horizontal"
            android:padding="3dp" />

        <!-- 3. Choghadiya Section -->
        <TextView
            android:id="@+id/tvChogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="TODAY'S CHOGHADIYA (DAY)"
            android:textColor="#73FFFFFF"
            android:textSize="9.5sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="0.16" />

        <LinearLayout
            android:id="@+id/chogStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_strip_frosted"
            android:orientation="horizontal"
            android:padding="3dp" />

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="6dp"
                android:paddingBottom="24dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
